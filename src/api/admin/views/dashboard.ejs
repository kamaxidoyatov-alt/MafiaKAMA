<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid #2a2a3a; margin-bottom: 30px; }
        .header h1 { color: #ffd700; font-size: 24px; }
        .nav { display: flex; gap: 15px; }
        .nav a { color: #888; text-decoration: none; padding: 8px 16px; border-radius: 8px; transition: all 0.2s; }
        .nav a:hover, .nav a.active { color: #ffd700; background: rgba(255, 215, 0, 0.1); }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: #1a1a2e; border-radius: 12px; padding: 20px; border: 1px solid #2a2a3a; }
        .stat-card h3 { color: #888; font-size: 14px; text-transform: uppercase; margin-bottom: 8px; }
        .stat-card .value { font-size: 32px; font-weight: bold; color: #fff; }
        .stat-card .value.gold { color: #ffd700; }
        .stat-card .value.green { color: #4ade80; }
        .stat-card .value.red { color: #f87171; }
        .stat-card .value.blue { color: #60a5fa; }
        .section { background: #1a1a2e; border-radius: 12px; padding: 20px; margin-bottom: 20px; border: 1px solid #2a2a3a; }
        .section h2 { color: #ffd700; margin-bottom: 15px; font-size: 18px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #2a2a3a; }
        th { color: #888; font-size: 12px; text-transform: uppercase; }
        td { color: #ccc; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
        .badge.green { background: rgba(74, 222, 128, 0.2); color: #4ade80; }
        .badge.red { background: rgba(248, 113, 113, 0.2); color: #f87171; }
        .badge.blue { background: rgba(96, 165, 250, 0.2); color: #60a5fa; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎭 MafiaBOT Admin</h1>
            <div class="nav">
                <a href="/admin" class="active">📊 Дашборд</a>
                <a href="/admin/rooms">🚪 Комнаты</a>
                <a href="/admin/players">👥 Игроки</a>
                <a href="/admin/logs">📝 Логи</a>
                <a href="/admin/analytics">📈 Аналитика</a>
                <a href="/admin/server">🔧 Сервер</a>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>Пользователи</h3>
                <div class="value blue"><%= stats ? stats.users : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Всего игр</h3>
                <div class="value"><%= stats ? stats.totalGames : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Активных игр</h3>
                <div class="value green"><%= stats ? stats.activeGames : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Завершено</h3>
                <div class="value"><%= stats ? stats.finishedGames : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Забанено</h3>
                <div class="value red"><%= stats ? stats.bannedPlayers : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Побед мафии</h3>
                <div class="value red"><%= stats ? stats.mafiaWins : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Побед мирных</h3>
                <div class="value green"><%= stats ? stats.peacefulWins : 0 %></div>
            </div>
            <div class="stat-card">
                <h3>Онлайн (час)</h3>
                <div class="value gold"><%= stats ? stats.activeUsersLastHour : 0 %></div>
            </div>
        </div>

        <div class="section">
            <h2>📊 Статистика побед</h2>
            <% if (stats) { %>
            <p>Мафия: <strong><%= stats.mafiaWins %></strong> (<%= stats.finishedGames > 0 ? Math.round(stats.mafiaWins/stats.finishedGames*100) : 0 %>%)</p>
            <p>Мирные: <strong><%= stats.peacefulWins %></strong> (<%= stats.finishedGames > 0 ? Math.round(stats.peacefulWins/stats.finishedGames*100) : 0 %>%)</p>
            <p>Маньяк: <strong><%= stats.maniacWins || 0 %></strong></p>
            <p>Ничьи: <strong><%= stats.draws || 0 %></strong></p>
            <% } %>
        </div>
    </div>
</body>
</html>
