<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        h1 { color: #ffd700; }
        .nav { margin: 20px 0; }
        .nav a { color: #888; text-decoration: none; padding: 8px 16px; }
        .nav a:hover { color: #ffd700; }
        .section { background: #1a1a2e; border-radius: 12px; padding: 20px; margin: 20px 0; border: 1px solid #2a2a3a; }
        .section h2 { color: #ffd700; margin-bottom: 15px; }
        .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #2a2a3a; }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav"><a href="/admin">← Назад</a></div>
        <h1>📈 Аналитика</h1>
        
        <div class="section">
            <h2>📊 Статистика по ролям</h2>
            <% if (roleStats) { %>
                <% Object.entries(roleStats).forEach(([role, data]) => { %>
                <div class="stat-row">
                    <span><%= role %></span>
                    <span>Игр: <%= data.games %>, Побед: <%= data.wins %>, Смертей: <%= data.deaths %></span>
                </div>
                <% }); %>
            <% } else { %>
                <p>Нет данных</p>
            <% } %>
        </div>
    </div>
</body>
</html>
