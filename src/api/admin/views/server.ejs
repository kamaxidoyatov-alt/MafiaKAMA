<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        h1 { color: #ffd700; }
        .nav { margin: 20px 0; }
        .nav a { color: #888; text-decoration: none; padding: 8px 16px; }
        .nav a:hover { color: #ffd700; }
        .section { background: #1a1a2e; border-radius: 12px; padding: 20px; margin: 20px 0; border: 1px solid #2a2a3a; }
        .section h2 { color: #ffd700; }
        .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #2a2a3a; }
    </style>
</head>
<body>
    <div class="container">
        <div class="nav"><a href="/admin">← Назад</a></div>
        <h1>🔧 Сервер</h1>
        <div class="section">
            <h2>⚙️ Конфигурация</h2>
            <div class="stat-row"><span>Режим:</span><span><%= config?.nodeEnv || 'N/A' %></span></div>
            <div class="stat-row"><span>LLM провайдер:</span><span><%= config?.llmProvider || 'N/A' %></span></div>
            <div class="stat-row"><span>Порт:</span><span><%= config?.port || 3000 %></span></div>
        </div>
        <div class="section">
            <h2>🤖 AI-агенты</h2>
            <div class="stat-row"><span>Всего:</span><span><%= agentStats?.total || 0 %></span></div>
            <div class="stat-row"><span>В игре:</span><span><%= agentStats?.inGame || 0 %></span></div>
            <div class="stat-row"><span>Свободны:</span><span><%= agentStats?.free || 0 %></span></div>
        </div>
        <div class="section">
            <h2>⚡ Производительность</h2>
            <div class="stat-row"><span>Uptime:</span><span><%= Math.floor(uptime / 60) %> минут</span></div>
            <div class="stat-row"><span>Память:</span><span><%= Math.round(memory?.heapUsed / 1024 / 1024) %> MB / <%= Math.round(memory?.heapTotal / 1024 / 1024) %> MB</span></div>
            <div class="stat-row"><span>Кэш хитов:</span><span><%= cacheStats?.hits || 0 %></span></div>
            <div class="stat-row"><span>Hit Rate:</span><span><%= cacheStats?.hitRate || 0 %>%</span></div>
        </div>
    </div>
</body>
</html>
