# ========================================
# Токен Telegram бота
# ========================================
BOT_TOKEN=ваш_токен_бота

# ========================================
# Настройки сервера
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# Supabase (PostgreSQL) — замена MongoDB
# ========================================
# 1. Зарегистрируйтесь на https://supabase.com
# 2. Создайте проект
# 3. Скопируйте Project URL, anon key и service_role key из Settings > API
# 4. Выполните SQL-скрипт из src/database/supabase-schema.sql в SQL Editor
SUPABASE_URL=https://ваш_проект.supabase.co
SUPABASE_ANON_KEY=ваш_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=ваш_service_role_key (только для серверных операций)

# ========================================
# Redis (опционально, для кэширования)
# ========================================
REDIS_URL=redis://redis:6379

# ========================================
# LLM API (OpenAI, Gemini или Claude)
# ========================================
# Выберите один провайдер AI:
LLM_PROVIDER=openic  # openai, gemini, claude

# OpenAI
OPENAI_API_KEY=ваш_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=ваш_gemini_api_key

# Anthropic Claude
CLAUDE_API_KEY=ваш_claude_api_key
CLAUDE_MODEL=claude-3-sonnet-20240229

# ========================================
# Админ-панель
# ========================================
ADMIN_EMAIL=admin@mafia-bot.com
ADMIN_PASSWORD=admin123
SESSION_SECRET=ваш_секретный_ключ_сессии
JWT_SECRET=ваш_jwt_секретный_ключ

# ========================================
# Настройки игры
# ========================================
MIN_PLAYERS_TO_START=4
MAX_PLAYERS=16
DAY_DURATION_SECONDS=60
NIGHT_DURATION_SECONDS=45
VOTE_DURATION_SECONDS=40
ROOM_CLEANUP_INTERVAL_MINUTES=30
GAME_RECOVERY_INTERVAL_SECONDS=10

# ========================================
# Логирование
# ========================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
